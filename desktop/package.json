{
  "name": "omniforge-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OMNIFORGE by ADEN INC. — on-device MICHELLE",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win nsis portable --x64",
    "test": "node --test tests/*.test.mjs"
  },
  "build": {
    "appId": "inc.aden.omniforge",
    "productName": "OMNIFORGE",
    "directories": {
      "output": "../dist-desktop"
    },
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html",
      "setup.js",
      "style.css",
      "model-policy.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../public",
        "to": "public"
      },
      {
        "from": "../server/local-runtime.mjs",
        "to": "server/local-runtime.mjs"
      },
      {
        "from": "engine",
        "to": "engine"
      },
      {
        "from": "offline-models",
        "to": "offline-models"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  }
}
