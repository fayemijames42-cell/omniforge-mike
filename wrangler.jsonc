{
  "name": "omniforge-mike",
  "main": "cloudflare-retired.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_BUDGET",
        "class_name": "DailyBudget"
      },
      {
        "name": "MIKEE_POOL",
        "class_name": "MikeeCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-daily-budget",
      "new_sqlite_classes": [
        "DailyBudget"
      ]
    },
    {
      "tag": "mikee-free-pool-v1",
      "new_sqlite_classes": [
        "MikeeCoordinator"
      ]
    }
  ]
}
